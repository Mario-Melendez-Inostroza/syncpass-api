# Plantilla del archivo de variables del servicio en la EC2: /etc/syncpass/syncpass.env
# Formato systemd: CLAVE=VALOR, SIN comillas y sin comentarios al final de la línea.
# Reemplaza cada <marcador> en la EC2 (sudo nano /etc/syncpass/syncpass.env). NUNCA subas el archivo real a Git.
# instalar-ec2.sh se niega a arrancar el servicio mientras quede algún <marcador>.

# --- Perfil de Spring ---
# prod: exige las variables de base de datos y fuerza SSL.
# demo: carga el catálogo FICTICIO (proyecto, eventos, asistentes). La API no tiene endpoints para crear
#       catálogo, así que sin "demo" la app no tendría nada que descargar. Todo el dato es ficticio (caso §5.1).
SPRING_PROFILES_ACTIVE=prod,demo

# --- Base de datos: Supabase (Session pooler, puerto 5432; el 6543 rompe Flyway) ---
DATABASE_URL=jdbc:postgresql://<host-del-session-pooler>:5432/<base>?sslmode=require
DATABASE_USER=postgres.<ref-del-proyecto>
DATABASE_PASSWORD=<contraseña-de-la-base>
DATABASE_POOL_MAX_SIZE=5

# --- Cognito ---
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=<id-del-user-pool>
AWS_COGNITO_CLIENT_ID=<id-del-app-client>
# El app client nuevo no tiene secreto: déjala vacía.
AWS_COGNITO_CLIENT_SECRET=

# --- CORS ---
# La ruta OPTIONS del API Gateway llega al backend: con CORS apagado el preflight del navegador recibe 403.
# API Gateway ignora las cabeceras CORS del backend y pone las suyas, así que no hay cabeceras duplicadas.
CORS_ENABLED=true
