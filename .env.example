# =============================================================================
# Configuración local de fs2-api (SyncPass).
#
#   1) Copia este archivo ->  Copy-Item .env.example .env
#   2) En el .env (NUNCA en este archivo) reemplaza cada <marcador> por tu valor real.
#   3) .env está en .gitignore: no lo subas a Git, no lo compartas ni lo pegues en un chat.
#
# Reglas del formato (las aplica la librería java-dotenv):
#   - Una línea CLAVE=VALOR por variable. Una línea sin "=" hace fallar el arranque.
#   - Sin comentarios al final de una línea de valor: todo lo que sigue al "=" es parte del valor.
#   - Comillas dobles: se quitan. Comillas simples: se conservan (no las uses).
#   - Guárdalo como UTF-8 SIN BOM (con BOM la primera línea falla). VS Code lo hace bien;
#     en Windows PowerShell 5.1 evita Set-Content/Out-File -Encoding UTF8.
#
# Prioridad: variable de entorno real > .env > valor por defecto de application.yml
# El .env se busca en el directorio desde el que arrancas la aplicación (la carpeta fs2-api).
# =============================================================================

# --- Base de datos: Supabase (Session pooler) ---
# Todo <...> se copia del panel de Supabase (botón "Connect").
DATABASE_URL=jdbc:postgresql://<host-del-session-pooler>:5432/<base>?sslmode=require
DATABASE_USER=postgres.<ref-del-proyecto>
DATABASE_PASSWORD=<contraseña-de-la-base>
# Máximo de conexiones del pool (opcional, por defecto 5):
# DATABASE_POOL_MAX_SIZE=5
# Alternativa con un PostgreSQL propio en tu equipo (reemplaza las tres líneas de arriba):
# DATABASE_URL=jdbc:postgresql://localhost:5432/<base-local>
# DATABASE_USER=<usuario-local>
# DATABASE_PASSWORD=<contraseña-local>

# --- AWS Cognito (consola de AWS, región de tu User Pool) ---
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=<id-del-user-pool>
AWS_COGNITO_CLIENT_ID=<id-del-app-client>
# Solo si el app client tiene secreto; si no, déjala vacía:
AWS_COGNITO_CLIENT_SECRET=

# --- CORS (opcional; estos son los valores por defecto) ---
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# =============================================================================
# LO QUE NO FUNCIONA DESDE ESTE ARCHIVO (se pasa de otra forma):
#   - Perfil de Spring (prod):  java -jar <app>.jar --spring.profiles.active=prod
#     (SPRING_PROFILES_ACTIVE sí funciona como variable de entorno real, no desde el .env)
#   - Puerto del servidor:      java -jar <app>.jar --server.port=8081
#   - Credenciales de AWS (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN):
#     el SDK de AWS no las lee desde el .env. En local defínelas como variables de entorno de
#     tu terminal; en EC2 usa el rol de la instancia.
# =============================================================================

# --- Validación de JWT (opcional) ---
# Por defecto se deriva de AWS_REGION y AWS_COGNITO_USER_POOL_ID. Solo hace falta si el issuer es otro.
# COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<id-del-user-pool>

# --- Notificaciones ntfy (opcional; estos son los valores por defecto) ---
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOPIC_PREFIX=app_vibe_
# NTFY_TOPIC_HASH_LENGTH=20
# NTFY_CONNECT_TIMEOUT=10
# NTFY_READ_TIMEOUT=30

# --- Datos de demostración ficticios ---
# Con SPRING_PROFILES_ACTIVE=demo Flyway carga un catalogo de prueba (db/demo). NUNCA en produccion.
# SPRING_PROFILES_ACTIVE=demo
